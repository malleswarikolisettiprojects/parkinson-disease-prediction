# Copy this file to .env and fill in your values
# .env is gitignored — never commit your actual secrets!

# Flask secret key — use a long random string in production
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your-secret-key-here

# Set to 'true' only for local development, never in production
FLASK_DEBUG=false

# Port the Flask app listens on (default: 5000)
PORT=5000
